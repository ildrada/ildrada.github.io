# One test case per line. Lines starting with # are ignored.
# Fields: id, type, system, user, expected (fields compared to the JSON reply),
# checks (list of checks), expect_json (default true). {{profile}} is replaced by profile.txt.
{"id": "e1-extract-northwind", "type": "extract", "system": "You extract structured data from job postings for a job-search tracker.\nReply with one JSON object and nothing else, with these keys:\n\"title\" (string), \"company\" (string), \"location\" (city and country as a string),\n\"remote_policy\" (one of \"remote\", \"hybrid\", \"onsite\", \"unknown\"),\n\"salary_min\" and \"salary_max\" (yearly amounts as numbers, or null when not stated),\n\"currency\" (ISO 4217 code such as \"EUR\", or null),\n\"seniority\" (one of \"junior\", \"mid\", \"senior\", \"lead\", \"unknown\"),\n\"employment_type\" (one of \"permanent\", \"contract\", \"internship\", \"unknown\"),\n\"required_skills\" (list of short strings, only the skills stated as required),\n\"language\" (ISO 639-1 code of the language the posting is written in).", "user": "Job posting:\n\nSenior Data Analyst - Northwind Logistics\nDublin, Ireland | Hybrid (2 days on site) | Permanent, full time\nSalary: EUR 65,000 - 75,000 per year plus bonus\n\nNorthwind Logistics runs last-mile delivery for 1,200 retailers across Ireland and the UK. We are hiring a Senior Data Analyst to own operational reporting and to work with the product team on delivery-time predictions.\n\nWhat you will do\n- Build and maintain the Looker dashboards used by operations and finance\n- Model data in BigQuery with dbt and keep KPI definitions consistent\n- Run experiments on routing and dispatch changes and present results to the leadership team\n- Mentor two junior analysts\n\nWhat we need\n- 5+ years in analytics or business intelligence\n- Expert SQL and solid Python for analysis\n- Hands-on experience with dbt or a similar transformation tool\n- Clear communication with non-technical stakeholders\nNice to have: logistics or e-commerce background, Airflow.\n\nApply by 30 November. Northwind Logistics is an equal opportunity employer.", "expected": {"title": "Senior Data Analyst", "company": "Northwind Logistics", "location": "Dublin, Ireland", "remote_policy": "hybrid", "salary_min": 65000, "salary_max": 75000, "currency": "EUR", "seniority": "senior", "employment_type": "permanent", "required_skills": ["SQL", "Python", "dbt"], "language": "en"}}
{"id": "e2-extract-brightpath", "type": "extract", "system": "You extract structured data from job postings for a job-search tracker.\nReply with one JSON object and nothing else, with these keys:\n\"title\" (string), \"company\" (string), \"location\" (city and country as a string),\n\"remote_policy\" (one of \"remote\", \"hybrid\", \"onsite\", \"unknown\"),\n\"salary_min\" and \"salary_max\" (yearly amounts as numbers, or null when not stated),\n\"currency\" (ISO 4217 code such as \"EUR\", or null),\n\"seniority\" (one of \"junior\", \"mid\", \"senior\", \"lead\", \"unknown\"),\n\"employment_type\" (one of \"permanent\", \"contract\", \"internship\", \"unknown\"),\n\"required_skills\" (list of short strings, only the skills stated as required),\n\"language\" (ISO 639-1 code of the language the posting is written in).", "user": "Job posting:\n\nJunior Java Developer (m/f/d)\nBrightpath Software GmbH - Berlin, Germany - On site, full time, permanent\n\nWe build invoicing software for small businesses. You will join a team of eight engineers.\n\nYour tasks: implement features in Java 21 and Spring Boot, write unit tests, take part in code reviews, maintain SQL queries for our PostgreSQL database.\nYour profile: a degree in computer science or a completed apprenticeship, first experience with Java and Spring Boot (internships count), basic SQL, good German or English.\nWe offer: 30 days of holiday, a public transport ticket, a learning budget.\nSalary is discussed in the first interview.", "expected": {"title": "Junior Java Developer", "company": "Brightpath Software", "location": "Berlin, Germany", "remote_policy": "onsite", "salary_min": null, "salary_max": null, "currency": null, "seniority": "junior", "employment_type": "permanent", "required_skills": ["Java", "Spring Boot", "SQL"], "language": "en"}}
{"id": "e3-extract-lumen", "type": "extract", "system": "You extract structured data from job postings for a job-search tracker.\nReply with one JSON object and nothing else, with these keys:\n\"title\" (string), \"company\" (string), \"location\" (city and country as a string),\n\"remote_policy\" (one of \"remote\", \"hybrid\", \"onsite\", \"unknown\"),\n\"salary_min\" and \"salary_max\" (yearly amounts as numbers, or null when not stated),\n\"currency\" (ISO 4217 code such as \"EUR\", or null),\n\"seniority\" (one of \"junior\", \"mid\", \"senior\", \"lead\", \"unknown\"),\n\"employment_type\" (one of \"permanent\", \"contract\", \"internship\", \"unknown\"),\n\"required_skills\" (list of short strings, only the skills stated as required),\n\"language\" (ISO 639-1 code of the language the posting is written in).", "user": "Job posting:\n\nAnalytics Engineer (Remote, EU time zones)\nLumen Health | Fully remote within the EU | Permanent\nEUR 60,000 - 70,000 depending on experience\n\nLumen Health builds appointment software for clinics in 11 countries. Our data team of four is looking for an Analytics Engineer to own the dbt project and the Snowflake warehouse.\n\nResponsibilities: design and maintain dbt models; manage the Snowflake warehouse (cost, access, performance); build data quality tests; support analysts with well-documented marts; own the Airflow deployments of the pipelines.\nRequirements: 3+ years working with SQL in a data role; production experience with dbt; experience with Snowflake, BigQuery or Redshift; Python for scripting; comfortable working asynchronously in a remote team.\nBonus: Looker or Metabase; healthcare data.\nWe hire in any EU country where we have an entity: Ireland, France, Germany, Spain, Netherlands.", "expected": {"title": "Analytics Engineer", "company": "Lumen Health", "location": {"any_of": ["EU", "European Union", "Europe", "remote"]}, "remote_policy": "remote", "salary_min": 60000, "salary_max": 70000, "currency": "EUR", "seniority": "mid", "employment_type": "permanent", "required_skills": ["SQL", "dbt", "Snowflake", "Python"], "language": "en"}}
{"id": "e4-extract-verdier-fr", "type": "extract", "system": "You extract structured data from job postings for a job-search tracker.\nReply with one JSON object and nothing else, with these keys:\n\"title\" (string), \"company\" (string), \"location\" (city and country as a string),\n\"remote_policy\" (one of \"remote\", \"hybrid\", \"onsite\", \"unknown\"),\n\"salary_min\" and \"salary_max\" (yearly amounts as numbers, or null when not stated),\n\"currency\" (ISO 4217 code such as \"EUR\", or null),\n\"seniority\" (one of \"junior\", \"mid\", \"senior\", \"lead\", \"unknown\"),\n\"employment_type\" (one of \"permanent\", \"contract\", \"internship\", \"unknown\"),\n\"required_skills\" (list of short strings, only the skills stated as required),\n\"language\" (ISO 639-1 code of the language the posting is written in).", "user": "Job posting:\n\nData Analyst (H/F) - CDI\nMaison Verdier - Lyon (69), télétravail partiel (2 jours par semaine)\nRémunération : 45 000 € à 52 000 € brut annuel selon profil\n\nMaison Verdier, groupe familial de distribution alimentaire (1 800 salariés), recrute un·e Data Analyst pour son équipe Data de 6 personnes basée à Lyon.\n\nMissions : construire et maintenir les tableaux de bord Power BI des directions commerce et supply ; écrire et optimiser les requêtes SQL sur l'entrepôt de données (SQL Server) ; automatiser les reportings en Python ; accompagner les équipes métier dans la lecture des indicateurs.\nProfil : formation Bac+5 en statistiques, data ou équivalent ; 3 ans d'expérience minimum en analyse de données ; maîtrise de SQL et de Power BI ; bonnes bases en Python ; anglais professionnel apprécié.\nPoste en CDI, statut cadre, à pourvoir dès que possible.", "expected": {"title": "Data Analyst", "company": "Maison Verdier", "location": "Lyon, France", "remote_policy": "hybrid", "salary_min": 45000, "salary_max": 52000, "currency": "EUR", "seniority": "mid", "employment_type": "permanent", "required_skills": ["SQL", "Power BI", "Python"], "language": "fr"}}
{"id": "e5-extract-granite-usd", "type": "extract", "system": "You extract structured data from job postings for a job-search tracker.\nReply with one JSON object and nothing else, with these keys:\n\"title\" (string), \"company\" (string), \"location\" (city and country as a string),\n\"remote_policy\" (one of \"remote\", \"hybrid\", \"onsite\", \"unknown\"),\n\"salary_min\" and \"salary_max\" (yearly amounts as numbers, or null when not stated),\n\"currency\" (ISO 4217 code such as \"EUR\", or null),\n\"seniority\" (one of \"junior\", \"mid\", \"senior\", \"lead\", \"unknown\"),\n\"employment_type\" (one of \"permanent\", \"contract\", \"internship\", \"unknown\"),\n\"required_skills\" (list of short strings, only the skills stated as required),\n\"language\" (ISO 639-1 code of the language the posting is written in).", "user": "Job posting:\n\nSenior Business Intelligence Analyst\nGranite Peak Software - Remote (United States only)\n$95,000 - $110,000 per year + equity\n\nAbout the role: you will build the reporting layer for our sales and customer success teams, partner with RevOps, and define the metrics the company runs on.\nMust have: 6+ years in BI or analytics; advanced SQL; Tableau; experience with Snowflake; ability to work with executives. Must be authorized to work in the US; we cannot sponsor visas.\nPreferred: dbt, Salesforce data model, Python.\nFull-time employee position.", "expected": {"title": "Senior Business Intelligence Analyst", "company": "Granite Peak Software", "location": {"any_of": ["United States", "USA", "U.S."]}, "remote_policy": "remote", "salary_min": 95000, "salary_max": 110000, "currency": "USD", "seniority": "senior", "employment_type": "permanent", "required_skills": ["SQL", "Tableau", "Snowflake"], "language": "en"}}
{"id": "d1-digest-three-postings", "type": "digest", "system": "You read job alert e-mails. Extract every distinct job posting listed in the e-mail.\nReply with one JSON object and nothing else: {\"postings\": [{\"title\": string, \"company\": string, \"location\": string}]}\nIgnore navigation text, tips, adverts, \"jobs you may also like\" suggestions without a company, and unsubscribe footers. If there are no postings, return {\"postings\": []}.", "user": "E-mail:\n\nFrom: Jobs Digest <alerts@jobdigest.example>\nSubject: 3 new jobs for \"data analyst\" in Ireland\n\nHi Alex, here are new jobs matching your saved search.\n\nData Analyst\nFernwood Bank - Dublin, Ireland - Hybrid\nPosted 2 days ago - EUR 55k-65k\n\nAnalytics Engineer\nCloudmere - Remote (Ireland)\nPosted 1 day ago - dbt, Snowflake, SQL\n\nBI Developer\nHarbour Freight Solutions - Cork, Ireland - On site\nPosted today\n\n----\nTips for you: \"5 ways to make your CV stand out\" - read it on our blog.\nJobs you may also like: Marketing Executive, Sales Development Representative\nYou receive this e-mail because you created a job alert. Unsubscribe | Manage alerts\nJobs Digest Ltd, 12 Quay Street, Dublin 2", "checks": [{"type": "json_valid"}, {"type": "list_length", "field": "postings", "min": 3, "max": 3}, {"type": "list_contains", "field": "postings.title", "values": ["Data Analyst", "Analytics Engineer", "BI Developer"]}, {"type": "list_contains", "field": "postings.company", "values": ["Fernwood Bank", "Cloudmere", "Harbour Freight Solutions"]}]}
{"id": "c1-classify-newsletter", "type": "classify", "system": "You triage e-mails for a job-search assistant. Reply with one JSON object and nothing else:\n{\"is_job_alert\": true or false, \"posting_count\": integer}\nAn e-mail is a job alert only if it lists at least one specific job opening with an employer.", "user": "E-mail:\n\nFrom: Jobs Digest <news@jobdigest.example>\nSubject: Your weekly career tips\n\nHi Alex,\nThis week on the blog:\n- How to answer \"tell me about yourself\" (4 min read)\n- Salary negotiation: three mistakes to avoid\n- Webinar on 14 November: getting started with dbt, with guest speakers from two Dublin companies\nKeep your profile updated so recruiters can find you.\nUnsubscribe | Manage preferences\nJobs Digest Ltd, 12 Quay Street, Dublin 2", "expected": {"is_job_alert": false, "posting_count": 0}}
{"id": "c2-classify-alert", "type": "classify", "system": "You triage e-mails for a job-search assistant. Reply with one JSON object and nothing else:\n{\"is_job_alert\": true or false, \"posting_count\": integer}\nAn e-mail is a job alert only if it lists at least one specific job opening with an employer.", "user": "E-mail:\n\nFrom: Jobs Digest <alerts@jobdigest.example>\nSubject: 3 new jobs for \"data analyst\" in Ireland\n\nHi Alex, here are new jobs matching your saved search.\n\nData Analyst\nFernwood Bank - Dublin, Ireland - Hybrid\nPosted 2 days ago - EUR 55k-65k\n\nAnalytics Engineer\nCloudmere - Remote (Ireland)\nPosted 1 day ago - dbt, Snowflake, SQL\n\nBI Developer\nHarbour Freight Solutions - Cork, Ireland - On site\nPosted today\n\n----\nTips for you: \"5 ways to make your CV stand out\" - read it on our blog.\nJobs you may also like: Marketing Executive, Sales Development Representative\nYou receive this e-mail because you created a job alert. Unsubscribe | Manage alerts\nJobs Digest Ltd, 12 Quay Street, Dublin 2", "expected": {"is_job_alert": true, "posting_count": 3}}
{"id": "c3-dedup-same-job", "type": "dedup", "system": "You decide whether two job postings describe the same job opening (same employer and same role, possibly reposted or reworded).\nReply with one JSON object and nothing else: {\"same_job\": true or false, \"reason\": short string}", "user": "Posting 1:\n\nSenior Data Analyst, Northwind Logistics, Dublin (hybrid, 2 days on site), EUR 65-75k. Own Looker dashboards and dbt models on BigQuery, run routing experiments, mentor two junior analysts. 5+ years, expert SQL, Python. Apply by 30 November.\n\nPosting 2:\n\nNorthwind Logistics is looking for a Senior Analyst (Data) - Dublin, hybrid working. 65-75k EUR plus bonus. You will own the operations dashboards (Looker), the dbt models on BigQuery and the dispatch experiments, and coach 2 junior analysts. Needs 5 years+ in analytics, strong SQL and Python. Closing date 30/11.", "expected": {"same_job": true}}
{"id": "c4-dedup-different-job", "type": "dedup", "system": "You decide whether two job postings describe the same job opening (same employer and same role, possibly reposted or reworded).\nReply with one JSON object and nothing else: {\"same_job\": true or false, \"reason\": short string}", "user": "Posting 1:\n\nSenior Data Analyst, Northwind Logistics, Dublin (hybrid, 2 days on site), EUR 65-75k. Own Looker dashboards and dbt models on BigQuery, run routing experiments, mentor two junior analysts. 5+ years, expert SQL, Python. Apply by 30 November.\n\nPosting 2:\n\nData Engineer - Northwind Logistics - Dublin, hybrid. EUR 80-90k. Build the streaming ingestion for driver telemetry (Kafka, Dataflow), own the Terraform for our GCP data platform, and support the analytics team's dbt models. 4+ years in data engineering, Python, Java or Go.", "expected": {"same_job": false}}
{"id": "s1-fit-northwind-good", "type": "fit", "system": "You score how well a job posting fits a candidate. Use only the candidate profile and the posting.\nReply with one JSON object and nothing else:\n{\"fit_score\": number from 0 to 100, \"reasons\": [up to 3 short strings], \"blockers\": [short strings, empty list if none]}\nA blocker is a hard obstacle such as missing work authorization, a required relocation the candidate refuses, or a role family the candidate excludes.\nScore below 40 when the role, seniority, location or work authorization clearly conflicts with what the candidate wants or can do. Score above 70 when most hard requirements and the candidate's preferences match.\n\nCandidate profile:\n{{profile}}", "user": "Job posting:\n\nSenior Data Analyst - Northwind Logistics\nDublin, Ireland | Hybrid (2 days on site) | Permanent, full time\nSalary: EUR 65,000 - 75,000 per year plus bonus\n\nNorthwind Logistics runs last-mile delivery for 1,200 retailers across Ireland and the UK. We are hiring a Senior Data Analyst to own operational reporting and to work with the product team on delivery-time predictions.\n\nWhat you will do\n- Build and maintain the Looker dashboards used by operations and finance\n- Model data in BigQuery with dbt and keep KPI definitions consistent\n- Run experiments on routing and dispatch changes and present results to the leadership team\n- Mentor two junior analysts\n\nWhat we need\n- 5+ years in analytics or business intelligence\n- Expert SQL and solid Python for analysis\n- Hands-on experience with dbt or a similar transformation tool\n- Clear communication with non-technical stakeholders\nNice to have: logistics or e-commerce background, Airflow.\n\nApply by 30 November. Northwind Logistics is an equal opportunity employer.", "checks": [{"type": "json_keys", "keys": ["fit_score", "reasons", "blockers"]}, {"type": "field_in_range", "field": "fit_score", "min": 65, "max": 100}]}
{"id": "s2-fit-brightpath-poor", "type": "fit", "system": "You score how well a job posting fits a candidate. Use only the candidate profile and the posting.\nReply with one JSON object and nothing else:\n{\"fit_score\": number from 0 to 100, \"reasons\": [up to 3 short strings], \"blockers\": [short strings, empty list if none]}\nA blocker is a hard obstacle such as missing work authorization, a required relocation the candidate refuses, or a role family the candidate excludes.\nScore below 40 when the role, seniority, location or work authorization clearly conflicts with what the candidate wants or can do. Score above 70 when most hard requirements and the candidate's preferences match.\n\nCandidate profile:\n{{profile}}", "user": "Job posting:\n\nJunior Java Developer (m/f/d)\nBrightpath Software GmbH - Berlin, Germany - On site, full time, permanent\n\nWe build invoicing software for small businesses. You will join a team of eight engineers.\n\nYour tasks: implement features in Java 21 and Spring Boot, write unit tests, take part in code reviews, maintain SQL queries for our PostgreSQL database.\nYour profile: a degree in computer science or a completed apprenticeship, first experience with Java and Spring Boot (internships count), basic SQL, good German or English.\nWe offer: 30 days of holiday, a public transport ticket, a learning budget.\nSalary is discussed in the first interview.", "checks": [{"type": "json_keys", "keys": ["fit_score", "reasons", "blockers"]}, {"type": "field_in_range", "field": "fit_score", "min": 0, "max": 40}]}
{"id": "s3-fit-orbit-poor", "type": "fit", "system": "You score how well a job posting fits a candidate. Use only the candidate profile and the posting.\nReply with one JSON object and nothing else:\n{\"fit_score\": number from 0 to 100, \"reasons\": [up to 3 short strings], \"blockers\": [short strings, empty list if none]}\nA blocker is a hard obstacle such as missing work authorization, a required relocation the candidate refuses, or a role family the candidate excludes.\nScore below 40 when the role, seniority, location or work authorization clearly conflicts with what the candidate wants or can do. Score above 70 when most hard requirements and the candidate's preferences match.\n\nCandidate profile:\n{{profile}}", "user": "Job posting:\n\nHead of Marketing - Orbit Retail\nLondon, UK | On site 5 days a week | Permanent\nGBP 90,000 - 105,000\n\nOrbit Retail operates 140 homeware stores. We are hiring a Head of Marketing to lead a team of 12 across brand, performance marketing and CRM, own a GBP 6m budget and report to the CEO.\nRequirements: 10+ years in marketing with at least 4 in a leadership role; retail or consumer brand experience; proven P&L ownership; comfortable presenting to the board.", "checks": [{"type": "json_keys", "keys": ["fit_score", "reasons", "blockers"]}, {"type": "field_in_range", "field": "fit_score", "min": 0, "max": 35}]}
{"id": "s4-fit-granite-blocked", "type": "fit", "system": "You score how well a job posting fits a candidate. Use only the candidate profile and the posting.\nReply with one JSON object and nothing else:\n{\"fit_score\": number from 0 to 100, \"reasons\": [up to 3 short strings], \"blockers\": [short strings, empty list if none]}\nA blocker is a hard obstacle such as missing work authorization, a required relocation the candidate refuses, or a role family the candidate excludes.\nScore below 40 when the role, seniority, location or work authorization clearly conflicts with what the candidate wants or can do. Score above 70 when most hard requirements and the candidate's preferences match.\n\nCandidate profile:\n{{profile}}", "user": "Job posting:\n\nSenior Business Intelligence Analyst\nGranite Peak Software - Remote (United States only)\n$95,000 - $110,000 per year + equity\n\nAbout the role: you will build the reporting layer for our sales and customer success teams, partner with RevOps, and define the metrics the company runs on.\nMust have: 6+ years in BI or analytics; advanced SQL; Tableau; experience with Snowflake; ability to work with executives. Must be authorized to work in the US; we cannot sponsor visas.\nPreferred: dbt, Salesforce data model, Python.\nFull-time employee position.", "checks": [{"type": "json_keys", "keys": ["fit_score", "reasons", "blockers"]}, {"type": "field_in_range", "field": "fit_score", "min": 0, "max": 45}, {"type": "list_length", "field": "blockers", "min": 1, "max": 10}]}
{"id": "w1-cover-letter-northwind", "type": "draft", "system": "You write short, specific cover letters. Plain text only: no markdown, no subject line, no placeholders in square brackets. Between 150 and 220 words. Name the company and the role, and connect two concrete achievements from the profile to what the posting asks for.\n\nCandidate profile:\n{{profile}}", "expect_json": false, "user": "Write the cover letter for this posting.\n\nSenior Data Analyst - Northwind Logistics\nDublin, Ireland | Hybrid (2 days on site) | Permanent, full time\nSalary: EUR 65,000 - 75,000 per year plus bonus\n\nNorthwind Logistics runs last-mile delivery for 1,200 retailers across Ireland and the UK. We are hiring a Senior Data Analyst to own operational reporting and to work with the product team on delivery-time predictions.\n\nWhat you will do\n- Build and maintain the Looker dashboards used by operations and finance\n- Model data in BigQuery with dbt and keep KPI definitions consistent\n- Run experiments on routing and dispatch changes and present results to the leadership team\n- Mentor two junior analysts\n\nWhat we need\n- 5+ years in analytics or business intelligence\n- Expert SQL and solid Python for analysis\n- Hands-on experience with dbt or a similar transformation tool\n- Clear communication with non-technical stakeholders\nNice to have: logistics or e-commerce background, Airflow.\n\nApply by 30 November. Northwind Logistics is an equal opportunity employer.", "checks": [{"type": "word_count", "min": 140, "max": 240}, {"type": "contains", "value": "Northwind"}, {"type": "contains", "value": "Senior Data Analyst"}, {"type": "regex", "pattern": "churn|dbt|Looker|BigQuery"}, {"type": "not_contains", "value": "["}, {"type": "not_contains", "value": "<think>"}]}
{"id": "w2-summary-lumen", "type": "draft", "system": "Summarise job postings for a daily digest. Reply with exactly three bullet lines, each starting with \"- \", no heading, no other text, at most 60 words in total.\nLine 1: role, company, location and remote policy. Line 2: pay and seniority. Line 3: the two or three most important requirements.", "expect_json": false, "user": "Job posting:\n\nAnalytics Engineer (Remote, EU time zones)\nLumen Health | Fully remote within the EU | Permanent\nEUR 60,000 - 70,000 depending on experience\n\nLumen Health builds appointment software for clinics in 11 countries. Our data team of four is looking for an Analytics Engineer to own the dbt project and the Snowflake warehouse.\n\nResponsibilities: design and maintain dbt models; manage the Snowflake warehouse (cost, access, performance); build data quality tests; support analysts with well-documented marts; own the Airflow deployments of the pipelines.\nRequirements: 3+ years working with SQL in a data role; production experience with dbt; experience with Snowflake, BigQuery or Redshift; Python for scripting; comfortable working asynchronously in a remote team.\nBonus: Looker or Metabase; healthcare data.\nWe hire in any EU country where we have an entity: Ireland, France, Germany, Spain, Netherlands.", "checks": [{"type": "line_count", "min": 3, "max": 3}, {"type": "regex", "pattern": "^- "}, {"type": "word_count", "min": 15, "max": 70}, {"type": "contains", "value": "Lumen Health"}]}
